{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "paths": {
      "preact": ["./vendor/preact/src/index.d.ts"],
      "preact/hooks": ["./vendor/preact/hooks/src/index.d.ts"],
      "preact/jsx-runtime": ["./vendor/preact/jsx-runtime/src/index.d.ts"]
    }
  },
  "include": ["src"]
}
